// This is your Prisma schema file for Storefront for Machines

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MERCHANT_ADMIN
  AI_AGENT
  DEVELOPER
  SYSTEM
}

enum DiscrepancyStatus {
  ACTIVE_DRIFT_ALERT
  DISCREPANCY_FLAGGED
  REMEDIATED
  IGNORED
}

enum MandateStatus {
  ACTIVE
  EXHAUSTED
  REVOKED
  EXPIRED
}

enum TransactionStatus {
  PENDING_GATE_APPROVAL
  AUTONOMOUS_APPROVED
  HUMAN_APPROVED
  CAPTURED_SUCCESS
  HALTED_PRICE_DRIFT
  MANDATE_REJECTED
  REFUNDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  role          Role           @default(MERCHANT_ADMIN)
  apiKey        String         @unique @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  merchants     Merchant[]
  mandates      PaymentMandate[]
}

model Merchant {
  id                   String              @id @default(uuid())
  name                 String
  slug                 String              @unique
  category             String
  website              String
  currency             String              @default("INR")
  country              String              @default("IN")
  razorpayAccountId    String?
  logoUrl              String?
  description          String?
  verificationStatus   String              @default("VERIFIED")
  mcpEndpoint          String              @default("/api/mcp/tools")
  geoVisibilityScore   Float               @default(50.0)
  trustScore           Float               @default(90.0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  userId               String?
  user                 User?               @relation(fields: [userId], references: [id])
  products             Product[]
  agentRuns            AgentRun[]
  integrityReports     IntegrityReport[]
  visibilityReports    VisibilityReport[]
  cartSessions         CartSession[]
  transactions         Transaction[]
  sourceConnections    SourceConnection[]
}

model Product {
  id                   String              @id @default(uuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  canonicalId          String              @unique
  title                String
  slug                 String
  brand                String
  category             String
  description          String
  price                Float
  mrp                  Float
  currency             String              @default("INR")
  stockQuantity        Int                 @default(0)
  isAvailable          Boolean             @default(true)
  rating               Float               @default(5.0)
  reviewCount          Int                 @default(0)
  imageUrl             String?
  taxRate              Float               @default(0.18)
  attributes           Json?
  rawSourceData        Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  variants             Variant[]
  discrepancies        IntegrityReport[]
}

model Variant {
  id                   String              @id @default(uuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String              @unique
  name                 String
  price                Float
  stock                Int                 @default(0)
  attributes           Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model AgentRun {
  id                   String              @id @default(uuid())
  agentType            String              // INGEST, INTEGRITY, VISIBILITY, OUTREACH, PAYMASTER, MASTER_ORCHESTRATOR
  merchantId           String?
  merchant             Merchant?           @relation(fields: [merchantId], references: [id])
  status               String              // SUCCESS, RUNNING, FAILED, HALTED
  inputPayload         Json?
  outputPayload        Json?
  executionTimeMs      Int                 @default(0)
  tokensUsed           Int                 @default(0)
  logs                 Json?
  createdAt            DateTime            @default(now())
}

model IntegrityReport {
  id                   String              @id @default(uuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?            @relation(fields: [productId], references: [id])
  productTitle         String
  sourceChannel        String
  sourceUrl            String
  detectedIssue        String
  merchantCanonicalPrice Float
  externalScrapedPrice Float
  priceDriftPercentage Float
  confidenceScore      Float
  status               DiscrepancyStatus   @default(ACTIVE_DRIFT_ALERT)
  suggestedAction      String
  triggerFailDemo      Boolean             @default(false)
  lastCrawledAt        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model VisibilityReport {
  id                   String              @id @default(uuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  intentQuery          String
  targetCategory       String
  overallScore         Float
  answerEngines        Json
  remediatedAt         DateTime?
  createdAt            DateTime            @default(now())
}

model BuyerIntent {
  id                   String              @id @default(uuid())
  customerIntent       String
  productsRequested    Json
  budget               Float
  confidence           Float
  channel              String              @default("AI_SHOPPING_AGENT")
  traiConsentVerified  Boolean             @default(true)
  createdAt            DateTime            @default(now())
  cartSessions         CartSession[]
}

model CartSession {
  id                   String              @id @default(uuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  buyerIntentId        String?
  buyerIntent          BuyerIntent?        @relation(fields: [buyerIntentId], references: [id])
  cartItems            Json
  subtotal             Float
  tax                  Float
  totalAmount          Float
  currency             String              @default("INR")
  status               String              // OPEN, ABANDONED, CONVERTED_TO_PAYMENT
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  transactions         Transaction[]
}

model PaymentMandate {
  id                   String              @id @default(uuid())
  buyerAgentId         String
  title                String
  userId               String?
  user                 User?               @relation(fields: [userId], references: [id])
  maxPerTransaction    Float
  dailySpendLimit      Float
  spentToday           Float               @default(0)
  remainingDailyBudget Float
  allowedCategories    Json
  autonomousThreshold  Float               @default(2000)
  status               MandateStatus       @default(ACTIVE)
  expiryTimestamp      DateTime
  cryptoSignature      String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  transactions         Transaction[]
}

model Transaction {
  id                   String              @id @default(uuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  cartSessionId        String?
  cartSession          CartSession?        @relation(fields: [cartSessionId], references: [id])
  mandateId            String?
  mandate              PaymentMandate?     @relation(fields: [mandateId], references: [id])
  actingAgent          String
  buyerIntentText      String
  amount               Float
  currency             String              @default("INR")
  idempotencyKey       String              @unique
  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?
  gateDecision         String
  approver             String
  passedConstraints    Json
  status               TransactionStatus
  reversalPath         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  auditLog             AuditLog?
}

model AuditLog {
  id                   String              @id @default(uuid())
  transactionId        String              @unique
  transaction          Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  rawTimelineRecord    Json
  explanationText      String
  verifiedHash         String
  createdAt            DateTime            @default(now())
}

enum SourceType {
  WEBSITE
  SHOPIFY
  WOOCOMMERCE
  MAGENTO
  CUSTOM_API
  PDF_CATALOG
  GOOGLE_BUSINESS
}

model SourceConnection {
  id              String           @id @default(uuid())
  merchantId      String
  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type            SourceType
  name            String
  endpointUrl     String?
  credentials     Json?
  status          String           @default("ACTIVE")
  lastSyncedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  syncHistory     SyncHistory[]
  extractionLogs  ExtractionLog[]
}

model SyncHistory {
  id              String           @id @default(uuid())
  connectionId    String
  connection      SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status          String           @default("SUCCESS")
  productsFound   Int              @default(0)
  productsSynced  Int              @default(0)
  errorsCount     Int              @default(0)
  durationMs      Int              @default(0)
  details         Json?
  createdAt       DateTime         @default(now())
}

model ExtractionLog {
  id              String           @id @default(uuid())
  connectionId    String
  connection      SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  stage           String
  message         String
  level           String           @default("INFO")
  timestamp       DateTime         @default(now())
}
